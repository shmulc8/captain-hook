{
  "hooks": {
    "pre_user_prompt": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PrePrompt",
        "show_output": false
      }
    ],
    "pre_read_code": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PreRead"
      }
    ],
    "pre_write_code": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PreWrite"
      }
    ],
    "post_write_code": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PostWrite"
      }
    ],
    "pre_run_command": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PreCommand"
      }
    ],
    "post_run_command": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PostCommand"
      }
    ],
    "pre_mcp_tool_use": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PreMCP"
      }
    ],
    "post_mcp_tool_use": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PostMCP"
      }
    ]
  }
}
