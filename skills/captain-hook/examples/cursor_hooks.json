{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PrePrompt"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PreCommand"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PreMCP"
      }
    ],
    "beforeReadFile": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PreRead"
      }
    ],
    "afterFileEdit": [
      {
        "command": "<CAPTAIN_HOOK> dispatch PostWrite"
      }
    ],
    "stop": [
      {
        "command": "<CAPTAIN_HOOK> dispatch SessionEnd"
      }
    ]
  }
}
